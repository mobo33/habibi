{
  "rules": {
    "submissions": {
      ".read": "auth != null && auth.uid === 'YOUR_ADMIN_UID'",
      ".write": "auth != null && auth.uid === 'YOUR_ADMIN_UID'",
      "$sid": {
        ".write": "$sid.matches(/^[a-z0-9]{8,40}$/)",
        "answers": {
          "$qi": {
            ".validate": "$qi.matches(/^[0-9]$/) && newData.hasChildren(['q', 'a', 't'])",
            "q": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "a": { ".validate": "newData.isString() && newData.val().length <= 2000" },
            "t": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "done": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    }
  }
}
